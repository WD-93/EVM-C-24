/*
A module used for specifying primitive types and functions in an ergonomic
format. This is used for type checking; during compilation special
treatment of the primitives takes over.
Definitions of the primfuns are placeholders a la let x = x in x in GHC.Prim;
they're required for type inference but overridden in later stages.
Thanks to kind signatures, every primitive kind but (->) can be declared here.
*/

//Primitive kinds
//Kind does not itself have a kind, bounding the kind hierarchy to depth 3
//The kind of all value types
Type : Kind;
default Type = Word;
//Type-level naturals
Nat : Kind;
//This causes integer literals without a restricted type to default to Word
//(desirable for perf reasons), but arrays without a set length will default
//to length 32! TODO: more flexible per-tycon argument and function
//tyvar defaults.
//The len parameter of Ints is now the number of bytes since that's the
//minimum granularity and type-level division by 8 is not desirable.
default Nat = 32;
//Regions, used to parameterize pointers and boxed datatypes
Region : Kind;
default Region = Memory;
Memory : Region;
Storage : Region;
TStorage : Region;
Calldata : Region;
Returndata : Region;
Code : Region;

//Indicates whether an Int is signed
Signedness : Kind;
default Signedness = Unsigned;
Signed : Signedness;
Unsigned : Signedness;

//Primitive types
//Int's structure can't be defined in the language because it's variable-size.
Int : Signedness -> Nat -> Type;
data Int s l = {};

//While the structure of Ptr and Fun can be defined in the language, the
//compiler treats them specially.
Ptr : Region -> Type -> Type;
data Ptr r a = {MkPtr (UInt 2)};
//In order to make use of the structure of the referenced type when optimizing
//pointer writes we must distinguish between initialized and uninitialized
//pointers. UPtr represents the latter.
//The uninitialized pointer API.
//Prim and Prelude are growing quite large, so it's worth splitting them into
//submodules; TODO.

//The UPtr type, representing a reference to an a in region r which has not
//yet been initialized.
UPtr : Region -> Type -> Type;
data UPtr r a = {MkUPtr (UInt 2)};
//Write an a to an uninitialized pointer, after which it may safely be
//initialized. Only valid for mutable regions.
writeUPtr : (UPtr r a, a) -> ();
instance writeUPtr : (UPtr Memory a, a) -> () where
 _ := ();
instance writeUPtr : (UPtr Storage a, a) -> () where
 _ := ();
instance writeUPtr : (UPtr TStorage a, a) -> () where
 _ := ();
//Analogous to indexPtr for Ptrs; over- or underflow causes terrible UB
//(an invalid bitpattern in the return value).
indexUPtr : (UPtr r a, Short) -> UPtr r a;
indexUPtr (up,ix) := {
 up :: UPtr r a;
 var wup = coerce up :: Word,
     wix = coerce ix,
     sz = coerce (sizeof (P :: P a));
 return unsafeCoerce (wup + wix*sz)
};
initUPtr : UPtr r a -> Ptr r a;
initUPtr up := return coerce up;
//(->) is desugared to Fun
//Represented as ((a,(b,Env#) -> End#) -> End# in Core
//TODO give Env#, End# and CoreFun representation in Prim?
data Fun a b = {MkFun (UInt 2)};
//Pair is the word-padding primitive: the Bytestring# repr of Pair a b is
//wordPad (toBS a) ++ wordPad (toBS b)
//Tuples are foldr Pair Unit
//Nested tuples are unique in that they can be deconstructed at no runtime
//cost (well, any zero-sized serializable type has the same property as Unit).
//They're therefore the only permissible let and lambda pattern in Core;
//any other pattern matching is implemented using case and let x = y.field.
data Pair a b = {Pair {fst: a, snd: b}};
//Unboxed arrays
//It needs to be declared for type inference to pass... but it really
//shouldn't have a .tagArray field...
Array : Nat -> Type -> Type;
data Array len a = {};

//Primfuns; constructs such as + or *_ desugar into prefix names.

//Since no unification occurs during the monomorphization and instantiation
//phase, sizeOfP : P a -> PN n is not useful.
//sizeof takes a proxy a and returns a SizeT (UInt 2)
sizeof : P a -> UInt 2;
sizeof p := {};

//Numeric ops
//Important: don't shadow the EVM opcode names! The EVMC ops do additional
//masking to keep them well-typed; the opcodes are of type Word* -> Word | ()
//Integer constants desugar to fromWord w, because all overloading is captured
//in polymorphic functions (which are then type applied during type inference).
fromWord : Word -> Int s len;
fromWord _ := ();

//Since pointer "addition" is moved to indexPtr, plus and minus can now have
//nice types.
//Design principle: sacrifice C-style sugar for better type inference.
//Arith on distinct int types now disallowed without an explicit coerce.
//Since they're now quantified polymorphic, perhaps implement using add, and,
//sizeof.
plus : (Int s l,Int s l) -> Int s l;
plus _ := ();
minus : (Int s l, Int s l) -> Int s l;
minus _ := ();

//Is it OK to make its type more restrictive than C's?
multiply : (Int a b, Int a b) -> Int a b;
multiply _ := ();
divide : (Int a b, Int a b) -> Int a b;
divide _ := ();
modulo : (Int a b, Int a b) -> Int a b;
modulo _ := ();

negate : Int a b -> Int a b;
negate _ := ();

shL : (Int a b, Int c d) -> Int a b;
shL _ := ();
shR : (Int a b, Int c d) -> Int a b;
shR _ := ();

//Pointer ops; writePtr isn't necessary here since it appears after type
//checking.

//With inbuilt support for malloc, every region can now be deref'd.
deref : Ptr r a -> a;
deref _ := ();
//Note the polymorphic result type independent of the argument!
//alloc n :: Ptr r a allocates enough space for n a's
//alloc is a fundamental operation in EVMC; beyond globals, it's the only
//safe way to get root pointers.
//The alloc# Core primitive should take an AllocPtr# resource but not return
//it, capturing that allocs are commutative.

//Should memAllocPtr be exposed directly?
//It's a word for efficiency; it may or may not be placed at address 0.
//Should the memory model assume it's never aliased so it can be stack-lifted
//more often? That would be in contrast to other globals.
//memAllocPtr should be initialized to point to the first free byte after
//the memory globals.
//If no alloc is actually done it should be optimized away.
memAllocPtr : Word;
memory memAllocPtr;
//stoAllocPtr is a Short in the hopes that it can share a slot with another
//global. Ideally it would be optimized away.
stoAllocPtr : Short;
storage stoAllocPtr;
//Is there a solid case for ever needing to allocate things in tstorage?
//I'm not sure, but it doesn't hurt to have the option.
tstoAllocPtr : Short;
tstorage tstoAllocPtr;
//Since alloc doesn't initialize its contents, it must return a UPtr
alloc : Int s l -> UPtr r a;
//alloc is supported for three region types: Memory, Storage, TStorage
//These instances are just placeholders meant to trigger type errors when
//instantiating alloc with a non-allocable region; the real definition for
//each type is filled in in Core.
instance alloc : Int s l -> UPtr Memory a where
 _ := memAllocPtr; //Just used to mention relevant var
instance alloc : Int s l -> UPtr Storage a where
 _ := stoAllocPtr;
instance alloc : Int s l -> UPtr TStorage a where
 _ := tstoAllocPtr;
//What's this!? Well, boxed constructors Cons x xs desugar to
//ImplList (allocValue (ImplCons x xs)). However, allocValue to a region
//requires allocValue be supported. So to have code BDTs in constant
//expressions, you need a false code alloc instance.
instance alloc : Int s l -> UPtr Code a where
 _ := ();
//Pointer indexing _[_] is now separate from unboxed array indexing _!_.
//Since indexPtr can be implemented directly in EVMC, it needn't be in Prim.
//However, its supporting primitive proxy ops need to be.

//Obtains a's size at no runtime cost.
sizeofP : P a -> PN n;
sizeofP _ := ();
//Given a Nat proxy, obtains a runtime integer of any signedness and size
knownNat : PN n -> Int s l;
knownNat pn := ();
//TODO a region datatype and knownRegion.

//_!_ desugars to indexArray
//I'll restrict the index type to Short for now.
indexArray : (Array len a,Short) -> a;
indexArray _ := ();

//The other primitives are black magic but this one is blacker due to its
//non-compositional semantics.
// &e = p if e can be inferred to be *p
//Applicable arguments: *p (.field | !ix)*
//HM doesn't check the region is correct, that's done later.
addressOf : a -> Ptr r a;
addressOf _ := ();

//Short-circuited ops; if called on a non-explicit tuple the short-circuiting
//doesn't occur.
scAnd : (a,a) -> Bool;
scAnd _ := ();
scOr : (a,a) -> Bool;
scOr _ := ();

//Logical and bitwise ops
truthy : a -> Bool;
truthy _ := ();
lNot : a -> Bool;
lNot _ := ();
bwAnd : (a,a) -> a;
bwAnd _ := ();
bwOr : (a,a) -> a;
bwOr _ := ();
bwXor : (a,a) -> a;
bwXor _ := ();
bwNot : a -> a;
bwNot _ := ();

//Comparison ops
//Because block exprs have been removed, > can't be implemented as sugar for
// < with reverse argument eval order.
lt_ : (a,a) -> Bool;
lt_ _ := ();
lte_ : (a,a) -> Bool;
lte_ _ := ();
gt_ : (a,a) -> Bool;
gt_ _ := ();
gte_ : (a,a) -> Bool;
gte_ _ := ();
eq_ : (a,a) -> Bool;
eq_ _ := ();
neq_ : (a,a) -> Bool;
neq_ _ := ();

//Coercion
//coerce may result in an invalid bitpattern, but it at least masks the
//result to the correct bitlength
coerce : a -> b;
coerce _ := ();
//unsafeCoerce does not, which makes it cheaper but more dangerous.
unsafeCoerce : a -> b;
unsafeCoerce _ := ();

//Utility functions
//copy(to,from,n) copies n elems from from to to; it's a shared frontend for
//the EVM copy variants (mcopy, calldatacopy, returndatacopy, codecopy).
//extcodecopy is not covered because it requires an additional address
//argument.
copy : (MPtr a, Ptr r a, Int s l) -> ();
copy _ := ();

//RETURNs the given argument, malloc'd into memory
returnValue : a -> ();
returnValue _ := ();
//RETURNs the value pointed to
returnPtr : MPtr a -> ();
returnPtr _ := ();
//RETURN n elements pointed to
returnPtrLen : (MPtr a, Int s l) -> ();
returnPtrLen _ := ();
//Raw RETURN
returnRaw : (MPtr Byte, Int s l) -> ();
returnRaw _ := ();

//TODO Ditto for revert
//Solidity handles it via dispatch on the argument types, but that doesn't
//fit HM well.
//Sol's ABI serialization and deserialization for call/return is cool, but I
//don't need to add primitive support for it... it wouldn't work well with
//cyclical data structures anyway.
//Template polymorphism might be able to support serialize/deserialize.
//By returning the entire memory (with a mptr at a fixed address), you could
//convert a memory datatype to a returndata one and deserialize lazily.