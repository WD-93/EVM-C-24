//Standard type synonyms and datatypes imported by default into EVMC programs.
//No functions for now (need tree shaking opt first).
//Unlike Prim, these definitions aren't overridden during compilation.

//Type synonyms
//Since the language operates at byte granularity, we pass byte length rather
//than bitlength to Int.
type UInt = Int Unsigned;
type SInt = Int Signed;
type Byte = UInt 1;
type Char = Byte;
type Short = UInt 2;
type Size_T = Short;
type Long = UInt 4;
type Half = UInt 16;
type Word = UInt 32;

type MPtr = Ptr Memory;
type SPtr = Ptr Storage;
type TSPtr = Ptr TStorage;
type CaPtr = Ptr Calldata;
type RPtr = Ptr Returndata;
type CoPtr = Ptr Code;

type BytePtr r = Ptr r Byte;

//Datatypes; tuples desugar into hetlists of Pair and Unit.
//Struct a b c desugars into a hetlist of Append and Unit.
//While Append and Pair may seem to be isomorphic, the latter has word-padded
//elements under the hood.
data Unit = {Unit};
//Bytestring append without padding
//Append without padding is the default rule for datatypes.
//It has named fields to make creating Appends in the compiler more
//convenient.
data Append a b = {Append {first: a, second: b}};
//WordPad is now replaced by Pair as the word-padding primitive
type WordPad a = (a,());
//Datatypes with exactly 2 constructors have default tags [0,1], allowing
//case on them to use jumpi (16.5 gas) rather than a direct jump table (29).
//Datatypes with 3..16 constructors use 0,16.. (29 gas); datatypes with more
//use indirect JTs (36 gas).
data Bool = {False;True};
//Bool does not need an explicit tag declaration
//tag Bool = Byte where {False: 0, True: 1};
data Maybe a = {Nothing; Just {fromJust: a}}; //Unboxed
data List r a = {Nil; Cons {hd: a, tl: List r a}} region r;

//The proxy types
data P a = {P};
PR : Region -> Type;
data PR r = {PR};
PN : Nat -> Type;
data PN n = {PN};
PS : Signedness -> Type;
data PS s = {PS};

//A newtype wrapper for EVM addresses
data Addr = {Addr (UInt 20)};

//ptr[ix] => *(indexPtr (ptr,ix))
indexPtr : (Ptr re a, Short) -> Ptr re a;
indexPtr (ptr,ix) := {
 ptr :: Ptr r a;
 var wp  = coerce ptr :: Word,
     wsz = coerce (sizeof (P :: P a)),
     wix = coerce ix;
 return unsafeCoerce (wp + (wsz * wix))
 };
/*{
	 ptr :: Ptr r a;
	 var off;
	 MkPtr off = ptr;
	 var sz = sizeof (P :: P a);
	 return MkPtr (off + sz * ix)
};*/
//Pointer indexing is a fundamental operation, so it needs to be fast.
//Masking pointer addition to ensure pointers remain 16b is marginally safer,
//but you're still in big trouble if your pointer access overflows/underflows
//and the code corrupts globals. Masking also increases the cost of indexing
//by 6 gas. Instead, we implement indexing using unsafe word ops and make
//over/underflow UB.
//That requires subtracting 1 rather than adding 65535 in Ptr dec.
//Note the pointed type changes! That enables p->field to be implemented as
//unsafeAddPtr(p,k).
unsafeAddPtr : (Ptr re a, Short) -> Ptr re b;
unsafeAddPtr (ptr,n) := {
	     var pw = coerce ptr :: Word,
	         nw = coerce n :: Word;
             return unsafeCoerce (pw + nw) //Doesn't mask!
};

//_++ supports both pointers and integers; to do so it uses the class function
//inc rather than the more restrictive plus.
inc : a -> a;
instance inc : Ptr r a -> Ptr r a where
 p := return indexPtr (p,1);
instance inc : Int s l -> Int s l where
 n := return n+1;
//dec is the analogous function for _--
dec : a -> a;
instance dec : Ptr r a -> Ptr r a where
 p := {
  p :: Ptr r a;
  var wsz = coerce (sizeof (P :: P a)) :: Word;
  var wp = coerce p :: Word;
  return unsafeCoerce (wp - wsz)
  };
instance dec : Int s l -> Int s l where
 n := return n-1;

//null() :: t returns a value of type t which is all zero bytes;
//it's used as the default value of uninitialized locals, but may be an
//invalid value for the type.
//It's equivalent to coerce ().
null : () -> a;
null _ := return coerce();

//Allocates the given value to a new pointer.
//allocValue is currently used in desugaring BCon {field: e}
//Since that wastes space when allocating constructors that are smaller than
//the maximum size, that might change.
//Since code BDTs desugar to ImplCon (allocValue v), const serialization
//needs to support allocValue for code pointers.
//However, that needn't affect writeUPtr or alloc, which should ideally be
//limited to mem, sto and tsto. Solution: two instances for allocValue.
allocValue : a -> Ptr r a;
//FW: if a "dynamic" use of allocValue v :: Ptr Code a takes a const object,
//I could in fact permit it... at the cost of complicating the language
//further.
//Note it's extravagant to use a human-readable error string on the EVM.
//If you want informative errors, use an error datatype.
instance allocValue : a -> Ptr Code a where
 _ := revertValue();
instance allocValue : a -> Ptr Memory a where
 a := allocValueImplem a;
instance allocValue : a -> Ptr Storage a where
 a := allocValueImplem a;
instance allocValue : a -> Ptr Storage a where
 a := allocValueImplem a;

allocValueImplem : a -> Ptr r a;
allocValueImplem a := {
 var up = alloc 1;
 writeUPtr(up,a);
 return initUPtr up
}