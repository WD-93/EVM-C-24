//0xfa
staticcall : (Word,Word,Word,Word,Word,Word) -> Word;
staticcall _ := {};

//0xfd-0xff
revert : (Word,Word) -> ();
revert _ := {};
//invalid excluded
//selfdestruct is an exiting instruction, so I need to add another Branch type
//for it; TODO. It's low prio, since selfdestruct is basically deprecated.
selfdestruct : Word -> ();
selfdestruct _ := {};