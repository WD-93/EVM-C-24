//Primfun bindings for the EVM opcodes.
//The compiler replaces their empty bodies in Core with a single-op body.
//Ex:
//add(w1,w2) := () =>
//add (w1*w2*ret*stk,env) =
// let (x,()) = add ((w1,w2),())
// in jump (ret*x*stk,env)
//Ops that interact with state take and return vars from env.
//Ex:
//mstore(woff,wval) := () =>
//add (woff*wval*ret*stk,(mem,cd,...)) =
// let (x,mem') = mstore((woff,wval),mem)
// in jump (ret*x*stk,(mem',cd,...))
//The optimizer should inline them; that also allows independent ops to be
//reordered as tighter bounds on their effect can be found.
//Excluded:
//jump, jumpi (they're branches in Core, not ops)
//invalid (it's just a worse stop unless you're spiteful toward the caller)
//push* (accessible via constants and literals instead)
//dup*, swap* are excluded for now; the stack scheduler implicitly
//generates them.

//Update: for the Structured primitive rule in the compiler to fire, the
//definition must be _ := {}. Ditto for Core branching primitives.
//TODO auto-generate this module from OpcodeInfo.opcodes.

//This could be auto-generated from an iset spec: arity, returns, effect
//0x00-0x0b
stop : () -> ();
stop _ := {};
add : (Word,Word) -> Word;
add _ := {};
mul : (Word,Word) -> Word;
mul _ := {};
//It's unfortunate that sub, div, sdiv, mod, smod don't take the operand as
//the first argument: x-k, x/k, x%k are more common than the reverse and
//could generate efficient stack code if they did.
sub : (Word,Word) -> Word;
sub _ := {};
div : (Word,Word) -> Word;
div _ := {};
sdiv : (Word,Word) -> Word;
sdiv _ := {};
mod : (Word,Word) -> Word;
mod _ := {};
smod : (Word,Word) -> Word;
smod _ := {};
addmod : (Word,Word,Word) -> Word;
addmod _ := {};
mulmod : (Word,Word,Word) -> Word;
mulmod _ := {};
exp : (Word,Word) -> Word;
exp _ := {};
signextend : (Word,Word) -> Word;
signextend _ := {};

//0x10-0x1d
//Variants that return a Bool would be useful for the optimizer, but aren't
//appropriate here: first of all EVM should avoid locking in the user to
//particular type definitions as far as possible, and secondly being able to
//chain EVM primfun applications without unsafeCoercing to word is ergonomic.
lt : (Word,Word) -> Word;
lt _ := {};
gt : (Word,Word) -> Word;
gt _ := {};
slt : (Word,Word) -> Word;
slt _ := {};
sgt : (Word,Word) -> Word;
sgt _ := {};
eq : (Word,Word) -> Word;
eq _ := {};
iszero : Word -> Word;
iszero _ := {};
and : (Word,Word) -> Word;
and _ := {};
or : (Word,Word) -> Word;
or _ := {};
xor : (Word,Word) -> Word;
xor _ := {};
not : Word -> Word;
not _ := {};
byte : (Word,Word) -> Word;
byte _ := {};
shl : (Word,Word) -> Word;
shl _ := {};
shr : (Word,Word) -> Word;
shr _ := {};
sar : (Word,Word) -> Word;
sar _ := {};

//0x20
//sha3 is a synonym of keccak256
sha3 : (Word,Word) -> Word;
sha3 (off,len) := return keccak256(off,len);
keccak256 : (Word,Word) -> Word;
keccak256 _ := {};

//0x30-0x4a
address : () -> Word;
address _ := {};
balance : () -> Word;
balance _ := {};
origin : () -> Word;
origin _ := {};
caller : () -> Word;
caller _ := {};
callvalue : () -> Word;
callvalue _ := {};
calldataload : Word -> Word;
calldataload _ := {};
calldatasize : () -> Word;
calldatasize _ := {};
calldatacopy : (Word,Word,Word) -> ();
calldatacopy _ := {};
codesize : () -> Word;
codesize _ := {};
codecopy : (Word,Word,Word) -> ();
codecopy _ := {};
gasprice : () -> Word;
gasprice _ := {};
extcodesize : Word -> Word;
extcodesize _ := {};
extcodecopy : (Word,Word,Word,Word) -> ();
extcodecopy _ := {};
returndatasize : () -> Word;
returndatasize _ := {};
returndatacopy : (Word,Word,Word) -> ();
returndatacopy _ := {};
extcodehash : Word -> Word;
extcodehash _ := {};
blockhash : Word -> Word;
blockhash _ := {};
coinbase : () -> Word;
coinbase _ := {};
timestamp : () -> Word;
timestamp _ := {};
number : () -> Word;
number _ := {};
prevrandao : () -> Word;
prevrandao _ := {};
gaslimit : () -> Word;
gaslimit _ := {};
chainid : () -> Word;
chainid _ := {};
selfbalance : () -> Word;
selfbalance _ := {};
basefee : () -> Word;
basefee _ := {};
blobhash : Word -> Word;
blobhash _ := {};
blobbasefee : () -> Word;
blobbasefee _ := {};

//0x50-0x5e
//pop is the odd one out: it can be defined in C.
pop : Word -> ();
pop _ := return ();
mload : (Word,Word) -> Word;
mload _ := {};
mstore : (Word,Word) -> ();
mstore _ := {};
mstore8 : (Word,Word) -> ();
mstore8 _ := {};
sload : Word -> Word;
sload _ := {};
sstore : (Word,Word) -> ();
sstore _ := {};
//jump, jumpi excluded
pc : () -> Word;
pc _ := {};
msize : () -> Word;
msize _ := {};
gas : () -> Word;
gas _ := {};
//jumpdest excluded
tload : Word -> Word;
tload _ := {};
tstore : (Word,Word) -> ();
tstore _ := {};
mcopy : (Word,Word,Word) -> ();
mcopy _ := {};

//push*, dup*, swap* excluded

//0xa0-0xa4
log0 : (Word,Word) -> ();
log0 _ := {};
log1 : (Word,Word,Word) -> ();
log1 _ := {};
log2 : (Word,Word,Word,Word) -> ();
log2 _ := {};
log3 : (Word,Word,Word,Word,Word) -> ();
log3 _ := {};
log4 : (Word,Word,Word,Word,Word) -> ();
log4 _ := {};

//0xf0-0xf5
create : (Word,Word,Word) -> Word;
create _ := {};
call : (Word,Word,Word,Word,Word,Word,Word) -> Word;
call _ := {};
callcode : (Word,Word,Word,Word,Word,Word,Word) -> Word;
callcode _ := {};
//return must be called evm_return because return is a keyword in C
evm_return : (Word,Word) -> ();
evm_return _ := {};
delegatecall : (Word,Word,Word,Word,Word) -> Word;
delegatecall _ := {};
create2 : (Word,Word,Word,Word) -> Word;
