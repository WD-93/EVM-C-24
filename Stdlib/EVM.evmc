//return must be called evm_return because return is a keyword in C
evm_return : (Word,Word) -> ();
evm_return x := ();
delegatecall : (Word,Word,Word,Word,Word) -> Word;
delegatecall x := ();
create2 : (Word,Word,Word,Word) -> Word;
