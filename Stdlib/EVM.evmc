//0xfa
staticcall : (Word,Word,Word,Word,Word,Word) -> Word;
staticcall x := ();

//0xfd-0xff
revert : (Word,Word) -> ();
revert x := ();
//invalid excluded
selfdestruct : Word -> ();
selfdestruct x := ();