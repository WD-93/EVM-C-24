module UniSyn.Skel where

-- Haskell module generated by the BNF converter

import UniSyn.Abs
import UniSyn.ErrM
type Result = Err String

failure :: Show a => a -> Result
failure x = Bad $ "Undefined case: " ++ show x

transIdent :: Ident -> Result
transIdent x = case x of
  Ident string -> failure x
transUIdent :: UIdent -> Result
transUIdent x = case x of
  UIdent string -> failure x
transInfix :: Infix -> Result
transInfix x = case x of
  Infix string -> failure x
transModule :: Module -> Result
transModule x = case x of
  Mod uident ds -> failure x
  TestE e -> failure x
  TestS s -> failure x
transD :: D -> Result
transD x = case x of
  TySig e1 e2 -> failure x
  Defun ident e s -> failure x
transS :: S -> Result
transS x = case x of
  SE e -> failure x
  Return e -> failure x
  Ifte e s1 s2 -> failure x
  While e s -> failure x
  Do ss -> failure x
transE :: E -> Result
transE x = case x of
  EInt integer -> failure x
  EVar ident -> failure x
  ECon uident -> failure x
  EEmptyTup -> failure x
  EApp e1 e2 -> failure x

