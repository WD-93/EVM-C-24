{-# OPTIONS_GHC -fno-warn-incomplete-patterns #-}
module E.Print where

-- pretty-printer generated by the BNF converter

import E.Abs
import Data.Char


-- the top-level printing method
printTree :: Print a => a -> String
printTree = render . prt 0

type Doc = [ShowS] -> [ShowS]

doc :: ShowS -> Doc
doc = (:)

render :: Doc -> String
render d = rend 0 (map ($ "") $ d []) "" where
  rend i ss = case ss of
    "["      :ts -> showChar '[' . rend i ts
    "("      :ts -> showChar '(' . rend i ts
    "{"      :ts -> showChar '{' . new (i+1) . rend (i+1) ts
    "}" : ";":ts -> new (i-1) . space "}" . showChar ';' . new (i-1) . rend (i-1) ts
    "}"      :ts -> new (i-1) . showChar '}' . new (i-1) . rend (i-1) ts
    ";"      :ts -> showChar ';' . new i . rend i ts
    t  : "," :ts -> showString t . space "," . rend i ts
    t  : ")" :ts -> showString t . showChar ')' . rend i ts
    t  : "]" :ts -> showString t . showChar ']' . rend i ts
    t        :ts -> space t . rend i ts
    _            -> id
  new i   = showChar '\n' . replicateS (2*i) (showChar ' ') . dropWhile isSpace
  space t = showString t . (\s -> if null s then "" else (' ':s))

parenth :: Doc -> Doc
parenth ss = doc (showChar '(') . ss . doc (showChar ')')

concatS :: [ShowS] -> ShowS
concatS = foldr (.) id

concatD :: [Doc] -> Doc
concatD = foldr (.) id

replicateS :: Int -> ShowS -> ShowS
replicateS n f = concatS (replicate n f)

-- the printer class does the job
class Print a where
  prt :: Int -> a -> Doc
  prtList :: Int -> [a] -> Doc
  prtList i = concatD . map (prt i)

instance Print a => Print [a] where
  prt = prtList

instance Print Char where
  prt _ s = doc (showChar '\'' . mkEsc '\'' s . showChar '\'')
  prtList _ s = doc (showChar '"' . concatS (map (mkEsc '"') s) . showChar '"')

mkEsc :: Char -> Char -> ShowS
mkEsc q s = case s of
  _ | s == q -> showChar '\\' . showChar s
  '\\'-> showString "\\\\"
  '\n' -> showString "\\n"
  '\t' -> showString "\\t"
  _ -> showChar s

prPrec :: Int -> Int -> Doc -> Doc
prPrec i j = if j<i then parenth else id


instance Print Integer where
  prt _ x = doc (shows x)


instance Print Double where
  prt _ x = doc (shows x)


instance Print Ident where
  prt _ (Ident i) = doc (showString ( i))


instance Print UIdent where
  prt _ (UIdent i) = doc (showString ( i))


instance Print Infix where
  prt _ (Infix i) = doc (showString ( i))



instance Print D where
  prt i e = case e of
    TestE e_ -> prPrec i 0 (concatD [prt 0 e_])

instance Print S where
  prt i e = case e of
    SE e_ -> prPrec i 0 (concatD [prt 0 e_])

instance Print EField where
  prt i e = case e of
    ENamed id e_ -> prPrec i 0 (concatD [prt 0 id, doc (showString ":"), prt 0 e_])
    EAnon e_ -> prPrec i 0 (concatD [prt 0 e_])
  prtList _ [] = (concatD [])
  prtList _ [x] = (concatD [prt 0 x])
  prtList _ (x:xs) = (concatD [prt 0 x, doc (showString ","), prt 0 xs])
instance Print E where
  prt i e = case e of
    Struct efields -> prPrec i 7 (concatD [doc (showString "{"), prt 0 efields, doc (showString "}")])
    Int n -> prPrec i 7 (concatD [prt 0 n])
    Var id -> prPrec i 7 (concatD [prt 0 id])
    BitwiseOr e_1 e_2 -> prPrec i 3 (concatD [prt 3 e_1, doc (showString "|"), prt 7 e_2])
    And e_1 e_2 -> prPrec i 2 (concatD [prt 2 e_1, doc (showString "&&"), prt 3 e_2])
    Or e_1 e_2 -> prPrec i 1 (concatD [prt 1 e_1, doc (showString "||"), prt 2 e_2])
    Assign e_1 aop e_2 -> prPrec i 0 (concatD [prt 1 e_1, prt 0 aop, prt 0 e_2])

instance Print AOp where
  prt i e = case e of
    Eq -> prPrec i 0 (concatD [doc (showString "=")])
    PlusEq -> prPrec i 0 (concatD [doc (showString "+=")])
    MinusEq -> prPrec i 0 (concatD [doc (showString "-=")])
    MulEq -> prPrec i 0 (concatD [doc (showString "*=")])
    DivEq -> prPrec i 0 (concatD [doc (showString "/=")])
    ModEq -> prPrec i 0 (concatD [doc (showString "%=")])
    ShlEq -> prPrec i 0 (concatD [doc (showString "<<=")])
    ShrEq -> prPrec i 0 (concatD [doc (showString ">>=")])
    AndEq -> prPrec i 0 (concatD [doc (showString "&=")])
    XorEq -> prPrec i 0 (concatD [doc (showString "^=")])
    OrEq -> prPrec i 0 (concatD [doc (showString "|=")])

instance Print T where
  prt i e = case e of
    TVar -> prPrec i 0 (concatD [doc (showString "TYPE")])


