--Goodbye Haskell-style comments, they dont work with x-- or {--x--}
comment "//";
comment "/*" "*/";

--Ill see if merging Pat, T and E parsing solves reduce-reduce conflicts
token UIdent (upper (letter | digit | '_')*);
--No need to delete = or ., reserved words will handle :=, = and .field.
token Infix ((["!#@$%&/?+*-^|:=.><"])+);
token HexInteger ({"0x"} ["0123456789abcdefABCDEF"] +) ;

--layout "module";
Module. M ::= [D];
separator D ";";

--Defines the default type of tyvars of kind k; if unbound after inference,
--theyre unified with that type. The default must be monomorphic and of the
--given kind.
--If a tyvar of kind k is unbound and has no default, thats an error.
Default. D ::= "default" UIdent "=" T;
Defun. D ::= Ident E13 ":=" S;
--For class functions, where the definition used depends on the type.
--Ex: instance writePtr : (Ptr Memory a, a) -> () where x :=
--return (writePtrMem x)
Instance. D ::= "instance" Ident ":" T "where" E13 ":=" S;
--Type signatures are now used for globals and static constants as well.
TySig. D ::= Ident ":" T;
--To give a datatype a nonstandard kind, you need to give it an explicit
--signature.
KindSig. D ::= UIdent ":" T;
--type Con args = t
--t ::= t t | var | Con | t -> t
TySyn. D ::= "type" ConArgs "=" T;
CANil. ConArgs ::= UIdent;
CACons. ConArgs ::= ConArgs Ident;
Import. D ::= "import" ModuleName;
MNil. ModuleName ::= UIdent;
MCons. ModuleName ::= UIdent "." ModuleName;
--Ex: memory x : UInt 16
Global. D ::= GlobalRegion VarBind;
Memory. GlobalRegion ::= "memory";
Storage. GlobalRegion ::= "storage";
TStorage. GlobalRegion ::= "tstorage";
--Syntax: data TyCon a b c = {Con T1 T2... | Con {field: t,...}; ...}
-- [region var] --makes the type boxed
--Unboxed datatypes supersede structs and enums
--0-parameter datatypes are now permitted.
Data. D ::= "data" ConArgs "=" DataRHS;
Boxed. DataRHS ::= UnboxedRHS "region" Ident;
Unboxed. DataRHS ::= UnboxedRHS;
URHS. UnboxedRHS ::= "{" [DataCon] "}";
separator DataCon ";";
--Constructors: Con <0 or more ts> | Con {field: t, ...}
DCArgs. DataCon ::= DCA;
DCANil. DCA ::= UIdent;
DCACons. DCA ::= DCA T1;
--This causes a shift-reduce conflict with DCArgs, but that seems not to be
--a problem.
DCRecord. DataCon ::= UIdent "{" [RecordField] "}";
separator RecordField ","; --Con {} is equivalent to Con
RF. RecordField ::= Ident ":" T;
StaticData. D ::= Ident ":=" E;

SE. S ::= E;
If. S ::= "if" E "then" S "else" S "end";
While. S ::= "while" "(" E ")" S;
Return. S ::= "return" E;
--Yay, with no anonymous structs I can eliminate the do keyword!
Do. S ::= "{" [S] "}";
separator S ";";
--layout "of";
Case. S ::= "case" E "of" "{" [CASE] "}";
separator CASE ";";
C. CASE ::= E "=>" S;
--Break and continue are now only local
Break. S ::= "break";
Continue. S ::= "continue";
--With no block exprs, local return is no longer relevant
--LocalReturn. S ::= "localReturn" Integer E;
--For isnt essential, its a convenience feature
For. S ::= "for" "(" S ";" E ";" S ")" S;
--Declaring new locals is mandatory
Declare. S ::= "var" [VarBind]; --Ident "=" E;
separator nonempty VarBind ",";
JustVar. VarBind ::= Ident;
VarIs. VarBind ::= Ident "=" E;

--Ugly array expr syntax for now: array (e1,e2,e3,...)
--Anon static data and structs removed
--AnonStaticData. E13 ::= "staticData" "(" T ")" E13;
--AnonStaticDatatype. E13 ::= "staticDatatype" "(" T ")" E13;
--Struct. E13 ::= "{" [EField] "}";
--separator EField ",";
--Order enforced: [pad sz][align sz](e | field: e)
--EPad. EField ::= "wordpad" EField1;
--EF1. EField ::= EField1;
--EAlign. EField1 ::= "wordalign" EField2;
--EF2. EField1 ::= EField2;
--ENamed. EField2 ::= Ident ":" E;
--EAnon. EField2 ::= E;
EmptyTuple. E13 ::= "(" ")";
Tuple. E13 ::= "(" E "," [E] ")";
separator nonempty E ",";
HexInt. E13 ::= HexInteger;
Int. E13 ::= Integer;
Var. E13 ::= Ident;
String. E13 ::= String;
--ConApp. E13 ::= ConApp;
--ConAppNil. ConApp ::= UIdent;
--ConAppCons. ConApp ::= ConApp E13;
ConRecord. E13 ::= UIdent "{" [EField] "}";
separator EField ",";
EField. EField ::= Ident ":" E;
Con. E13 ::= UIdent;
--Con. E13 ::= UIdent;
Wild. E13 ::= "_";
--BlockE. E13 ::= "block" "{" [S] "}";

--Left-to-right
--12: _++ _-- call _[_] .field ->field
PlusPlusPost. E12 ::= E12 "++";
MinusMinusPost. E12 ::= E12 "--";
Index. E12 ::= E12 "[" E "]";
Dot. E12 ::= E12 "." Ident;
Bang. E12 ::= E12 "!" E13;
Arrow. E12 ::= E12 "->" Ident;
--Anonymous struct access (hash operator) removed
--For s.f x to parse corectly, Haskell-style application needs to be here
App. E12 ::= E12 E13;
--Right-to-left
--11: ++_ --_ +_ (omit?) -_ ! ~ cast(?) *_ &_ sizeof
PlusPlusPre. E11 ::= "++" E11;
MinusMinusPre. E11 ::= "--" E11;
Negate. E11 ::= "-" E11;
Not. E11 ::= "!" E11;
BitwiseNot. E11 ::= "~" E11;
Deref. E11 ::= "*" E11;
AddressOf. E11 ::= "&" E11;
--Left-to-right
--10: * / %
--I'll place @ here for now...
--At. E10 ::= E10 "@" E11;
Mul. E10 ::= E10 "*" E11;
Div. E10 ::= E10 "/" E11;
Mod. E10 ::= E10 "%" E11;
--9: + -
Plus. E9 ::= E9 "+" E10;
Minus. E9 ::= E9 "-" E10;
--8: << >>
Shl. E8 ::= E8 "<<" E9;
Shr. E8 ::= E8 ">>" E9;
--7: < <= > >=
MyLT. E7 ::= E7 "<" E8;
LTE. E7 ::= E7 "<=" E8;
MyGT. E7 ::= E7 ">" E8;
GTE. E7 ::= E7 ">=" E8;
--6: eq, neq
Eq. E6 ::= E6 "==" E7;
NEq. E6 ::= E6 "!=" E7;
--Smooth sailing above?
BitwiseAnd. E5 ::= E5 "&" E6;
BitwiseXor. E4 ::= E4 "^" E5;
BitwiseOr. E3 ::= E3 "|" E4;
And. E2 ::= E2 "&&" E3;
Or. E1 ::= E1 "||" E2;
--E2. E1 ::= E2;
coercions E 13;

--Right-to-left
Assign. E ::= E1 AOp E;
--Type annotation
--coerce and unsafeCoerce are now primfuns, not part of the syntax
TypeAnnot. E ::= E1 "::" T;

EqEq. AOp ::= "=";
PlusEq. AOp ::= "+=";
MinusEq. AOp ::= "-=";
MulEq. AOp ::= "*=";
DivEq. AOp ::= "/=";
ModEq. AOp ::= "%=";
ShlEq. AOp ::= "<<=";
ShrEq. AOp ::= ">>=";
AndEq. AOp ::= "&=";
XorEq. AOp ::= "^=";
OrEq. AOp ::= "|=";

TArrow. T ::= T1 "->" T;
--Leaf types
TVar. T2 ::= Ident;
TNat. T2 ::= Integer;
TCon. T2 ::= UIdent;
TEmptyTup. T2 ::= "(" ")";
TTup. T2 ::= "(" T "," [T] ")";
separator nonempty T ",";
--TLeaf. T2 ::= Ident;
--Type application
TApp. T1 ::= T1 T2;
--t[len] is sugar for Array len t
--List r a [t] should parse to List r (a[t])
TArray. T ::= T1 "[" T "]";
--a -> Ptr r a should parse to a -> (Ptr r a), not (a -> Ptr) r a

coercions T 2;


{-
TAgoo. T ::= "agoo";
T1Agoo. T1 ::= "aba";
TArrows. T ::= TLeaf; -- [T1];
--separator T1 "->";
TApp. T1 ::= T1 TLeaf;
TLeaf. T1 ::= TLeaf;
TVar. TLeaf ::= Ident;

TNat. TLeaf ::= Integer;
TCon. TLeaf ::= UIdent;
TEmptyTup. TLeaf ::= "(" ")";
TTup. TLeaf ::= "(" T "," [T] ")";
separator nonempty T ",";
-}