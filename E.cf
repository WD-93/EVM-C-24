--Goodbye Haskell-style comments, they dont work with x-- or {--x--}
comment "//";
comment "/*" "*/";

--Ill see if merging Pat, T and E parsing solves reduce-reduce conflicts
token UIdent (upper (letter | digit | '_')*);
--No need to delete = or ., reserved words will handle :=, = and .field.
token Infix ((["!#@$%&/?+*-^|:=.><"])+);
token HexInteger ({"0x"} ["0123456789abcdefABCDEF"] +) ;

--layout "module";
Module. M ::= [D];
separator D ";";

Defun. D ::= Ident E13 ":=" S;
--Type signatures are now used for globals and static constants as well.
TySig. D ::= Ident ":" T;
--type Con args = t
--t ::= t t | var | Con | t -> t
TySyn. D ::= "type" ConArgs "=" T;
CANil. ConArgs ::= UIdent;
CACons. ConArgs ::= ConArgs Ident;
Import. D ::= "import" ModuleName;
MNil. ModuleName ::= UIdent;
MCons. ModuleName ::= UIdent "." ModuleName;
--Ex: memory x : UInt 16
Global. D ::= GlobalRegion Ident;
Memory. GlobalRegion ::= "memory";
Storage. GlobalRegion ::= "storage";
TStorage. GlobalRegion ::= "tstorage";
--Syntax: data TyCon a b c = {Con T1 T2... | Con {field: t,...}; ...}
-- [region var] --makes the type boxed
--Unboxed datatypes supersede structs and enums
--0-parameter datatypes are now permitted.
Data. D ::= "data" ConArgs "=" DataRHS;
--Boxed. DataRHS ::= UnboxedRHS "region" Ident;
Unboxed. DataRHS ::= UnboxedRHS;
URHS. UnboxedRHS ::= "{" [DataCon] "}";
separator DataCon ";";
--Constructors: Con <0 or more ts> | Con {field: t, ...}
DCArgs. DataCon ::= DCA;
DCANil. DCA ::= UIdent;
DCACons. DCA ::= DCA T1;
--This causes a shift-reduce conflict with DCArgs, but that seems not to be
--a problem.
DCRecord. DataCon ::= UIdent "{" [RecordField] "}";
separator RecordField ","; --Con {} is equivalent to Con
RF. RecordField ::= Ident ":" T;
StaticData. D ::= Ident ":=" E;

SE. S ::= E;
If. S ::= "if" E "then" S "else" S "end";
While. S ::= "while" "(" E ")" S;
Return. S ::= "return" E;
--Yay, with no anonymous structs I can eliminate the do keyword!
Do. S ::= "{" [S] "}";
separator S ";";
--layout "of";
Case. S ::= "case" E "of" "{" [CASE] "}";
separator CASE ";";
--TODO add pattern type?
C. CASE ::= E "=>" S;
Break. S ::= "break" Integer;
Continue. S ::= "continue" Integer;
LocalReturn. S ::= "localReturn" Integer E;
--For isnt essential, its a convenience feature
For. S ::= "for" "(" S ";" E ";" S ")" S;

--Anon static data and structs removed
--AnonStaticData. E13 ::= "staticData" "(" T ")" E13;
--AnonStaticDatatype. E13 ::= "staticDatatype" "(" T ")" E13;
--Struct. E13 ::= "{" [EField] "}";
--separator EField ",";
--Order enforced: [pad sz][align sz](e | field: e)
--EPad. EField ::= "wordpad" EField1;
--EF1. EField ::= EField1;
--EAlign. EField1 ::= "wordalign" EField2;
--EF2. EField1 ::= EField2;
--ENamed. EField2 ::= Ident ":" E;
--EAnon. EField2 ::= E;
EmptyTuple. E13 ::= "(" ")";
Tuple. E13 ::= "(" E "," [E] ")";
separator nonempty E ",";
HexInt. E13 ::= HexInteger;
Int. E13 ::= Integer;
Var. E13 ::= Ident;
String. E13 ::= String;
Con. E13 ::= UIdent;
Wild. E13 ::= "_";
--BlockE. E13 ::= "block" "{" [S] "}";

--Left-to-right
--12: _++ _-- call _[_] .field ->field
PlusPlusPost. E12 ::= E12 "++";
MinusMinusPost. E12 ::= E12 "--";
Index. E12 ::= E12 "[" E "]";
Dot. E12 ::= E12 "." Ident;
Arrow. E12 ::= E12 "->" Ident;
--Anonymous struct access (hash operator) removed
--For s.f x to parse corectly, Haskell-style application needs to be here
App. E12 ::= E12 E13;
--Right-to-left
--11: ++_ --_ +_ (omit?) -_ ! ~ cast(?) *_ &_ sizeof
PlusPlusPre. E11 ::= "++" E11;
MinusMinusPre. E11 ::= "--" E11;
Negate. E11 ::= "-" E11;
Not. E11 ::= "!" E11;
BitwiseNot. E11 ::= "~" E11;
Deref. E11 ::= "*" E11;
AddressOf. E11 ::= "&" E11;
--Left-to-right
--10: * / %
--I'll place @ here for now...
--At. E10 ::= E10 "@" E11;
Mul. E10 ::= E10 "*" E11;
Div. E10 ::= E10 "/" E11;
Mod. E10 ::= E10 "%" E11;
--9: + -
Plus. E9 ::= E9 "+" E10;
Minus. E9 ::= E9 "-" E10;
--8: << >>
Shl. E8 ::= E8 "<<" E9;
Shr. E8 ::= E8 ">>" E9;
--7: < <= > >=
MyLT. E7 ::= E7 "<" E8;
LTE. E7 ::= E7 "<=" E8;
MyGT. E7 ::= E7 ">" E8;
GTE. E7 ::= E7 ">=" E8;
--6: eq, neq
Eq. E6 ::= E6 "==" E7;
NEq. E6 ::= E6 "!=" E7;
--Smooth sailing above?
BitwiseAnd. E5 ::= E5 "&" E6;
BitwiseXor. E4 ::= E4 "^" E5;
BitwiseOr. E3 ::= E3 "|" E4;
And. E2 ::= E2 "&&" E3;
Or. E1 ::= E1 "||" E2;
--E2. E1 ::= E2;
coercions E 13;

--Right-to-left
Assign. E ::= E1 AOp E;
--Coerce using ::
Coerce. E ::= E1 "::" T;
--Type declaration... using =: instead of : to avoid a shift-reduce
TypeIs. E ::= E1 "=:" T;
--Coercion without masking at runtime
UnsafeCoerce. E ::= E1 ":!" T;
--E1. E ::= E1;

EqEq. AOp ::= "=";
PlusEq. AOp ::= "+=";
MinusEq. AOp ::= "-=";
MulEq. AOp ::= "*=";
DivEq. AOp ::= "/=";
ModEq. AOp ::= "%=";
ShlEq. AOp ::= "<<=";
ShrEq. AOp ::= ">>=";
AndEq. AOp ::= "&=";
XorEq. AOp ::= "^=";
OrEq. AOp ::= "|=";

--Leaf types
TVar. T1 ::= Ident;
TNat. T1 ::= Integer;
TCon. T1 ::= UIdent;
--TStruct. T1 ::= "{" [TField] "}";
--separator TField ",";
--Order enforced: [pad sz][align sz](t | field: t)
--TPad. TField ::= "wordpad" TField1;
--TF1. TField ::= TField1;
--TAlign. TField1 ::= "wordalign" TField2;
--TF2. TField1 ::= TField2;
--TNamed. TField2 ::= Ident ":" T;
--TAnon. TField2 ::= T;
TEmptyTup. T1 ::= "(" ")";
TTup. T1 ::= "(" T "," [T] ")";
separator nonempty T ",";
--Type application
TApp. T ::= T T1;
--t[len] is sugar for Array len t
TArray. T ::= T "[" T "]";
TArrow. T ::= T "->" T1;
coercions T 1;