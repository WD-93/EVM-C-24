--Goodbye Haskell-style comments, they dont work with x-- or {--x--}
comment "//";
comment "/*" "*/";

--Ill see if merging Pat, T and E parsing solves reduce-reduce conflicts
token UIdent (upper (letter | digit | '_')*);
--No need to delete = or ., reserved words will handle :=, = and .field.
token Infix ((["!#@$%&/?+*-^|:=.><"])+);
--token HexNumber ( "0x" (['0'-'9''A'-'F''a'-'f']+) );
--token HexNumber ({"0x"} (["0123456789abcdefABCDEF"]+));

--layout "module";
Module. M ::= [D];
separator D ";";

Defun. D ::= Ident E13 ":=" S;
TySig. D ::= Ident ":" T;
--type Con args = t
--t ::= t t | var | Con | t -> t
TySyn. D ::= "type" ConArgs "=" T;
CANil. ConArgs ::= UIdent;
CACons. ConArgs ::= ConArgs Ident;
Import. D ::= "import" ModuleName;
MNil. ModuleName ::= UIdent;
MCons. ModuleName ::= UIdent "." ModuleName;
--Ex: memory x : UInt 16
Global. D ::= GlobalRegion Ident ":" T;
Memory. GlobalRegion ::= "memory";
Storage. GlobalRegion ::= "storage";
TStorage. GlobalRegion ::= "tstorage";
--layout "=";
Data. D ::= "data" ConLHS "=" "{" [DataCon] "}";
separator DataCon ";";
--0-parameter datatypes are now a syntax error
CLNil. ConLHS ::= UIdent Ident;
CLCons. ConLHS ::= ConLHS Ident;
--0-parameter constructors are now a syntax error
DC. DataCon ::= UIdent T;
Enum. D ::= "enum" UIdent "{" [EnumCon] "}";
separator EnumCon ",";
EC. EnumCon ::= Ident;

SE. S ::= E;
If. S ::= "if" E "then" S "else" S "end";
While. S ::= "while" "(" E ")" S;
Return. S ::= "return" E;
Do. S ::= "do" "{" [S] "}";
separator S ";";
--layout "of";
Case. S ::= "case" E "of" "{" [CASE] "}";
separator CASE ";";
--TODO add pattern type?
C. CASE ::= E "=>" S;

--L for leaf so I can add new precedence levels incrementally
Struct. E13 ::= "{" [EField] "}";
separator EField ",";
ENamed. EField ::= Ident ":" E;
EAnon. EField ::= E;
EmptyTuple. E13 ::= "(" ")";
Tuple. E13 ::= "(" E "," [E] ")";
separator nonempty E ",";
Int. E13 ::= Integer;
Var. E13 ::= Ident;
String. E13 ::= String;
Con. E13 ::= UIdent;
Wild. E13 ::= "_";

--Left-to-right
--12: _++ _-- call _[_] .field ->field
PlusPlusPost. E12 ::= E12 "++";
MinusMinusPost. E12 ::= E12 "--";
Index. E12 ::= E12 "[" E "]";
Dot. E12 ::= E12 "." Ident;
Arrow. E12 ::= E12 "->" Ident;
--Anonymous struct access
Hash. E12 ::= E12 "#" Integer;
--For s.f x to parse corectly, Haskell-style application needs to be here
App. E12 ::= E12 E13;
--Right-to-left
--11: ++_ --_ +_ (omit?) -_ ! ~ cast(?) *_ &_ sizeof
PlusPlusPre. E11 ::= "++" E11;
MinusMinusPre. E11 ::= "--" E11;
Negate. E11 ::= "-" E11;
Not. E11 ::= "!" E11;
BitwiseNot. E11 ::= "~" E11;
Deref. E11 ::= "*" E11;
AddressOf. E11 ::= "&" E11;
--Left-to-right
--10: * / %
Mul. E10 ::= E10 "*" E11;
Div. E10 ::= E10 "/" E11;
Mod. E10 ::= E10 "%" E11;
--9: + -
Plus. E9 ::= E9 "+" E10;
Minus. E9 ::= E9 "-" E10;
--8: << >>
Shl. E8 ::= E8 "<<" E9;
Shr. E8 ::= E8 ">>" E9;
--7: < <= > >=
MyLT. E7 ::= E7 "<" E8;
LTE. E7 ::= E7 "<=" E8;
MyGT. E7 ::= E7 ">" E8;
GTE. E7 ::= E7 ">=" E8;
--6: eq, new
Eq. E6 ::= E6 "==" E7;
NEq. E6 ::= E6 "!=" E7;
--Smooth sailing above?
BitwiseAnd. E5 ::= E5 "&" E6;
BitwiseXor. E4 ::= E4 "^" E5;
BitwiseOr. E3 ::= E3 "|" E4;
And. E2 ::= E2 "&&" E3;
Or. E1 ::= E1 "||" E2;
--E2. E1 ::= E2;
coercions E 13;

--Right-to-left
Assign. E ::= E1 AOp E;
--Coerce using ::
Coerce. E ::= E1 "::" T;
--E1. E ::= E1;

EqEq. AOp ::= "=";
PlusEq. AOp ::= "+=";
MinusEq. AOp ::= "-=";
MulEq. AOp ::= "*=";
DivEq. AOp ::= "/=";
ModEq. AOp ::= "%=";
ShlEq. AOp ::= "<<=";
ShrEq. AOp ::= ">>=";
AndEq. AOp ::= "&=";
XorEq. AOp ::= "^=";
OrEq. AOp ::= "|=";

--Leaf types
TVar. T1 ::= Ident;
TNat. T1 ::= Integer;
TCon. T1 ::= UIdent;
TStruct. T1 ::= "{" [TField] "}";
separator TField ",";
TNamed. TField ::= Ident ":" T;
TAnon. TField ::= T;
TEmptyTup. T1 ::= "(" ")";
TTup. T1 ::= "(" T "," [T] ")";
separator nonempty T ",";
--Type application
TApp. T ::= T T1;
--Fixed-size arrays, used in global decl syntax... todo add as a first-class
--type?
TArray. T ::= T "[" Integer "]";
TArrow. T ::= T "->" T1;
coercions T 1;

--P ::= _, var, Con apps, {p,field: p}, *e, p(.field|#ix)*, e[e]
{-
PAT. P3 ::= "PAT";
P3. P ::= P3;
-}
--Parens. P3 ::= "(" P ")";
{-
PVar. P3 ::= Ident;
PWild. P3 ::= "_";
PStruct. P3 ::= "{" [PField] "}";
separator PField ",";
PFAnon. PField ::= P;
PFNamed. PField ::= Ident ":" P;


PDot. P2 ::= PDots;
PDNil. PDots ::= P3;
PDDot. PDots ::= PDots "." Ident;
PDHash. PDots ::= PDots "#" Integer;
PCon. P ::= PCon;
PCNil. PCon ::= UIdent;
PCCons. PCon ::= PCon P3;
-}
--coercions P 2;
--P3. P ::= P3;



{-
Index. E ::= E3 "[" E "]";
Assign. E ::= E3 "=" E1;
Ops. E1 ::= E2 Infix OS;
PrefixOp. E1 ::= Infix E1;
--Ops. E1 ::= E1 Infix E2;
App. E2 ::= E2 E3;
Var. E3 ::= Ident;
Con. E3 ::= UIdent;
Dot. E3 ::= E3 "." Ident;
Hash. E3 ::= E3 "#" Integer;
--Since (E) E is identical to application, I need non-C syntax for
--coercion.
--For now Ill use e :: t, though thats a bit misleading: it doesnt inform
--any overloading of e since there is none, nor does it fail if e isnt t.
Int. E3 ::= Integer;
--HexInt. E3 ::= Integer;
Str. E3 ::= String;
EmptyTup. E3 ::= "(" ")";
Tup. E3 ::= "(" E "," [E] ")";
separator E ",";
EmptyStruct. E3 ::= "{" "}";
EStruct. E3 ::= "{" [Field] "}";
separator nonempty Field ",";
Wild. E3 ::= "_";
coercions E 3;

--Op sequence
OSNil. OS ::= E2;
OSCons. OS ::= E2 Infix OS;

--Struct fields
--May be annotated with pad <info>, align <info>,
--where info ::= bit | byte | word
AnnotPad. Field ::= "pad" PadInfo Field;
AnnotAlign. Field ::= "align" PadInfo Field;
Named. Field ::= Ident ":" E;
Anon. Field ::= E;

Bit. PadInfo ::= "bit";
Byte. PadInfo ::= "byte";
Word. PadInfo ::= "word";
-}