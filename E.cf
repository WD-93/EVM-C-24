--Haskell-style comments
comment "--";
comment "{-" "-}";

--Ill see if merging Pat, T and E parsing solves reduce-reduce conflicts
token UIdent (upper (letter | digit | '_')*);
--No need to delete = or ., reserved words will handle :=, = and .field.
token Infix ((["!#@$%&/?+*-^|:=.><"])+);
--token HexNumber ( "0x" (['0'-'9''A'-'F''a'-'f']+) );
--token HexNumber ({"0x"} (["0123456789abcdefABCDEF"]+));

layout "module";
Module. M ::= "module" "{" [D] "}";
separator D ";";
--MCons. M ::= D M;
--MNil. M ::= D;

--layout ":=";
Defun. D ::= Ident E3 ":=" S; --"{" [S] "}";
--separator S ";";
TySig. D ::= Ident ":" E;
--type Con args = t
--t ::= t t | var | Con | t -> t
TySyn. D ::= "type" ConArgs "=" E;
CANil. ConArgs ::= UIdent;
CACons. ConArgs ::= ConArgs Ident;
Import. D ::= "import" ModuleName;
MNil. ModuleName ::= UIdent;
MCons. ModuleName ::= UIdent "." ModuleName;
--Ex: memory x : UInt 16
Global. D ::= GlobalRegion Ident ":" E;
Memory. GlobalRegion ::= "memory";
Storage. GlobalRegion ::= "storage";
TStorage. GlobalRegion ::= "tstorage";
layout "=";
Data. D ::= "data" ConLHS "=" "{" [DataCon] "}";
separator DataCon ";";
--0-parameter datatypes are now a syntax error
CLNil. ConLHS ::= UIdent Ident;
CLCons. ConLHS ::= ConLHS Ident;
--0-parameter constructors are now a syntax error
DC. DataCon ::= UIdent E3;
Enum. D ::= "enum" UIdent "{" [EnumCon] "}";
separator EnumCon ",";
EC. EnumCon ::= Ident;

SE. S ::= E;
If. S ::= "if" E "then" S "else" S "end";
While. S ::= "while" "(" E ")" S;
Return. S ::= "return" E;
layout "do";
Do. S ::= "do" "{" [S] "}";
separator S ";";
layout "of";
Case. S ::= "case" E "of" "{" [CASE] "}";
separator CASE ";";
--TODO add pattern type?
C. CASE ::= E2 "=>" S;

Index. E ::= E3 "[" E "]";
Assign. E ::= E3 "=" E1;
Ops. E1 ::= E2 Infix OS;
PrefixOp. E1 ::= Infix E1;
--Ops. E1 ::= E1 Infix E2;
App. E2 ::= E2 E3;
Var. E3 ::= Ident;
Con. E3 ::= UIdent;
Dot. E3 ::= E3 "." Ident;
Hash. E3 ::= E3 "#" Integer;
--Since (E) E is identical to application, I need non-C syntax for
--coercion.
--For now Ill use e :: t, though thats a bit misleading: it doesnt inform
--any overloading of e since there is none, nor does it fail if e isn't t.
Int. E3 ::= Integer;
--HexInt. E3 ::= Integer;
Str. E3 ::= String;
EmptyTup. E3 ::= "(" ")";
Tup. E3 ::= "(" E "," [E] ")";
separator E ",";
EmptyStruct. E3 ::= "{" "}";
EStruct. E3 ::= "{" [Field] "}";
separator nonempty Field ",";
Wild. E3 ::= "_";
coercions E 3;

--Op sequence
OSNil. OS ::= E2;
OSCons. OS ::= E2 Infix OS;

--Struct fields
--May be annotated with pad <info>, align <info>,
--where info ::= bit | byte | word
AnnotPad. Field ::= "pad" PadInfo Field;
AnnotAlign. Field ::= "align" PadInfo Field;
Named. Field ::= Ident ":" E;
Anon. Field ::= E;

Bit. PadInfo ::= "bit";
Byte. PadInfo ::= "byte";
Word. PadInfo ::= "word";